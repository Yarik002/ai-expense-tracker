# ==============================
# TELEGRAM BOT
# ==============================
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=[123456789]

# ==============================
# DATABASE (PostgreSQL)
# ==============================
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_STRONG_PASSWORD_HERE@db:5432/expense_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
