GEMINI_VISION_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================
# SUBSCRIPTION PRICING
# ==============================
MONTHLY_STARS_PRICE=150
YEARLY_STARS_PRICE=1500
FREE_RECEIPT_LIMIT=3
